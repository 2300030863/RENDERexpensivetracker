# Copy this file to .env for local development. NEVER commit the real .env file
# and never put real credentials in this example file.

# Server
PORT=8086
NODE_ENV=development

# Database (MySQL / TiDB Cloud). TLS is on by default and the certificate is verified.
DB_HOST=your-database-host
DB_PORT=4000
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=expense_tracker
# DB_SSL=false                         # only for a local database without TLS
# DB_SSL_REJECT_UNAUTHORIZED=false     # last resort for self-signed certificates

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRATION=28800000

# First-run owner account (only used if no such user exists yet).
# Set these once, deploy, log in, then REMOVE OWNER_PASSWORD from the environment.
# OWNER_USERNAME=your-owner-username
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=choose-a-strong-password-with-letters-and-numbers

# Google sign-in: the OAuth client ID used by the frontend (backend verifies tokens against it)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email (Brevo API with SMTP fallback)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=
MAIL_FROM=your_email@example.com
MAIL_SENDER_NAME=Expense Tracker
BREVO_API_KEY=your_brevo_api_key_here

# Frontend origin(s) allowed to call this API (comma separated, exact origins only)
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=https://preview-1.vercel.app,https://preview-2.vercel.app

# Time zone used for "today" when processing recurring transactions
APP_TIMEZONE=Asia/Kolkata

# Payment Gateway (Razorpay Standard Checkout + UPI Intent + Dynamic QR)
# Get your API keys at: https://dashboard.razorpay.com/#/app/keys
# If left empty, system operates in high-fidelity Sandbox Simulation mode for offline/test environments
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Configure Webhook secret in Razorpay Dashboard > Settings > Webhooks pointing to /api/payments/gateway/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Merchant UPI VPA for Dynamic QR generation fallback
MERCHANT_UPI_VPA=expensetracker@icici
MERCHANT_NAME=Expense Tracker Enterprise
